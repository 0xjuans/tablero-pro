# ─── APP ──────────────────────────────────────────────────────────────────────
APP_URL=http://TU_IP_EC2
NODE_ENV=production

# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
POSTGRES_USER=tablero
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=tablero_pro
POSTGRES_PORT=5434
DATABASE_URL=postgresql://tablero:CAMBIA_ESTO@postgres:5432/tablero_pro

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERA_UN_SECRET_LARGO_AQUI
JWT_REFRESH_SECRET=GENERA_OTRO_SECRET_LARGO_AQUI
AUTH_SECRET=GENERA_OTRO_SECRET_LARGO_AQUI

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_S3_BUCKET_NAME=TU_BUCKET

# ─── GOOGLE OAUTH (opcional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── EMAIL ────────────────────────────────────────────────────────────────────
AWS_SES_FROM_EMAIL=noreply@tudominio.com
